# =============================================================================
# Environment variables — copy to .env and edit. .env is gitignored.
# =============================================================================
# Every variable here is optional: the project runs from config/config.yaml and
# config/config.local.yaml alone. There are no secrets, API keys or credentials
# in this project, and none should be added to this file.

# --- data ---------------------------------------------------------------------
# Absolute path to the directory holding final/, processed/, raw/ and samples/.
# Overrides paths.data_root from config/config.local.yaml and config/config.yaml.
# LANDSLIDE_DATA_ROOT=/path/to/data

# --- prediction API -----------------------------------------------------------
# Browser origins allowed to call the API, comma-separated. Defaults to the Vite
# dev server on 5173. The built frontend is same-origin and needs no entry.
# LANDSLIDE_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- frontend (build/dev time only) -------------------------------------------
# Backend the Vite dev-server proxy forwards /api to.
# VITE_API_TARGET=http://127.0.0.1:8000
# API origin baked into a production build, when the frontend is hosted apart
# from the API. Leave unset for same-origin deployments.
# VITE_API_BASE=
